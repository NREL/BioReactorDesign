FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

#include "${FOAM_CASE}/constant/globalVars"

internalField   uniform $omega_inlet_gas;

boundaryField
{
    sparger
    {
        type            fixedValue;
        value           uniform $omega_inlet_gas;
    }
    dye_inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
