FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    MeshPhi
    {
        solver    GAMG;
        smoother  symGaussSeidel;
        tolerance 1e-3;
        relTol    0;
    }

    bubbles
    {
        nCorr                1;
        tolerance            1e-4;
        scale                true;
        solveOnFinalIterOnly true;
        sourceUpdateInterval 1;
    }
    
    "alpha.*"
    {
        nCorrectors     1;
        nSubCycles      10;
/*
        MULES
        {
            nIter           1;
            globalBounds    yes;
        }

        MULESCorr       yes;
        MULESCorrRelax  0.5;
*/
        solver          GAMG;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0;
        minIter         1;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        smoother        DIC;
        tolerance       1e-9;
        relTol          0.001;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol         0;
    }

    "pcorr.*"
    {
        $p_rghFinal;
        tolerance       0.001;
        relTol          0;

    }

    "(U|k|omega|Yi|f).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0;
        minIter         1;
    }
    
    "(e|T).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0;
        minIter         0;
        maxIter         0;
    }
}

PIMPLE
{
    nOuterCorrectors    1;
    nCorrectors         7;
    nNonOrthogonalCorrectors 0;

    correctPhi          yes;
    correctMeshPhi      yes;
    solveComposition    yes;
    solveEnergy         no;

    faceMomentum        no;
    VmDdtCorrection     yes;
    dragCorrection      yes;
}

relaxationFactors
{
    equations
    {
        ".*"    0.99;
        "f.*"   0.99;
    }
}

