FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

#include "${FOAM_CASE}/constant/globalVars"

internalField   uniform $omega_inlet_gas;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $omega_inlet_gas;
    }

    outlet
    {
        type            zeroGradient;
    }

    defaultFaces
    {
        type            zeroGradient;
        //type            epsilonWallFunction;
        //value         $internalField;
    }

    // defaultFaces
    // {
    //     type            empty;
    // }
}

// ************************************************************************* //
